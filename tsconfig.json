{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "sync.ts",
    "cli/**/*.ts",
    "craft/**/*.ts",
    "mind/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "mcp/**"
  ]
}
