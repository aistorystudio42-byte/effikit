{
  "name": "effikit",
  "version": "1.0.0",
  "description": "Effikit — kişisel geliştirici araç seti. CLI, MCP sunucu ve hazır kod kütüphaneleri.",
  "type": "module",
  "bin": {
    "effikit": "./cli/index.js"
  },
  "scripts": {
    "add": "node --experimental-vm-modules cli/index.js",
    "sync": "npx tsx sync.ts",
    "type-check": "tsc --noEmit",
    "prepare": "node -e \"try{require('husky').install()}catch(e){if(e.code!=='MODULE_NOT_FOUND')throw e}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "husky": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "effikit",
    "developer-toolkit",
    "mcp",
    "claude",
    "ai-tools"
  ],
  "license": "MIT"
}
